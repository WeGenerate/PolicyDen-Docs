{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PolicyDen",
  "description": "PolicyDen documentation: how health & life insurance agencies use PolicyDen to manage contacts, policies, pipeline, tasks, meetings, SMS, calls, and the Atlas AI assistant.",
  "colors": {
    "primary": "#15803D",
    "light": "#22C55E",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "User guide",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "navigating-the-app"
            ]
          },
          {
            "group": "Contacts",
            "icon": "users",
            "pages": [
              "contacts/overview",
              "contacts/creating-contacts",
              "contacts/contact-profile",
              "contacts/importing-contacts",
              "contacts/exporting-contacts",
              "contacts/bulk-actions"
            ]
          },
          {
            "group": "Policies",
            "icon": "file-text",
            "pages": [
              "policies/overview",
              "policies/policy-profile",
              "policies/status-history",
              "policies/bulk-actions"
            ]
          },
          {
            "group": "Pipeline",
            "icon": "layout-grid",
            "pages": [
              "pipeline/overview",
              "pipeline/configuring-pipeline"
            ]
          },
          {
            "group": "Tasks",
            "icon": "list-todo",
            "pages": [
              "tasks/overview",
              "tasks/managing-tasks"
            ]
          },
          {
            "group": "Conversations",
            "icon": "messages-square",
            "pages": [
              "meetings/overview",
              "meetings/scheduling-meetings",
              "messages/overview",
              "calls/overview"
            ]
          },
          {
            "group": "Atlas",
            "icon": "sparkles",
            "pages": [
              "atlas/overview"
            ]
          },
          {
            "group": "Dashboard and reports",
            "icon": "activity",
            "pages": [
              "dashboard/overview",
              "reports/overview"
            ]
          },
          {
            "group": "Your data",
            "icon": "sliders",
            "pages": [
              "customization/notes-and-comments",
              "customization/documents",
              "customization/saved-filters",
              "customization/custom-fields"
            ]
          }
        ]
      },
      {
        "tab": "Settings",
        "icon": "settings",
        "groups": [
          {
            "group": "Your account",
            "icon": "user",
            "pages": [
              "settings/profile",
              "settings/password"
            ]
          },
          {
            "group": "Agency",
            "icon": "building",
            "pages": [
              "settings/agency-overview",
              "settings/users-and-roles",
              "settings/products-and-carriers",
              "settings/agency-custom-fields",
              "settings/sms-numbers",
              "settings/templates",
              "settings/billing"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://app.policyden.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@policyden.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.policyden.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "PolicyDen docs",
      "og:type": "website"
    }
  },
  "search": {
    "prompt": "Search PolicyDen docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "errors": {
    "404": {
      "title": "We can't find that page",
      "description": "This page may have moved or been renamed. Try the [docs home](/), the [quickstart](/quickstart), or [Agency settings](/settings/agency-overview)."
    }
  },
  "footer": {
    "socials": {},
    "links": [
      {
        "header": "Get started",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "App tour", "href": "/navigating-the-app" },
          { "label": "Atlas", "href": "/atlas/overview" }
        ]
      },
      {
        "header": "Work your book",
        "items": [
          { "label": "Contacts", "href": "/contacts/overview" },
          { "label": "Policies", "href": "/policies/overview" },
          { "label": "Pipeline", "href": "/pipeline/overview" },
          { "label": "Messages", "href": "/messages/overview" }
        ]
      },
      {
        "header": "Admin",
        "items": [
          { "label": "Agency settings", "href": "/settings/agency-overview" },
          { "label": "Users and roles", "href": "/settings/users-and-roles" },
          { "label": "Reports", "href": "/reports/overview" },
          { "label": "Billing", "href": "/settings/billing" }
        ]
      },
      {
        "header": "Help",
        "items": [
          { "label": "Email support", "href": "mailto:support@policyden.com" },
          { "label": "Open the app", "href": "https://app.policyden.com" }
        ]
      }
    ]
  }
}
